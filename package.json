{
  "name": "circinus-ad-astra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit && vue-tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . && node --test scripts/shared/*.check.mjs scripts/architecture/*.check.mjs && node scripts/check-architecture.mjs && npm run lint:css && node scripts/check-identifier-length.mjs",
    "lint:css": "node scripts/check-styles.mjs",
    "encoding:check": "node scripts/check-encoding.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "release": "powershell -ExecutionPolicy Bypass -File ./build.ps1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "marked": "^18.1.1",
    "naive-ui": "^2.45.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "css-tree": "^3.2.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
