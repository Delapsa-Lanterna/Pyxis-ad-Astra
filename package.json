{
  "name": "pyxis-ad-astra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:browser": "node scripts/browser/serve.mjs browser",
    "dev:testbed": "node scripts/browser/serve.mjs testbed",
    "typecheck": "npm run typecheck:app && npm run typecheck:test && npm run typecheck:node && npm run typecheck:scripts && npm run typecheck:browser-scripts",
    "typecheck:app": "vue-tsc -p tsconfig.json",
    "typecheck:test": "vue-tsc -p tsconfig.test.json",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:browser-scripts": "tsc -p tsconfig.browser-scripts.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "lint:full": "eslint . --config eslint.full.config.js --max-warnings 0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "lint:checks": "node scripts/check-architecture.mjs && node scripts/check-imports.mjs && node scripts/check-styles.mjs && node scripts/check-identifier-length.mjs && node scripts/check-encoding.mjs && node scripts/check-text-guidelines.mjs",
    "format": "prettier --log-level warn --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --log-level warn --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "vitest run --reporter=default",
    "test:rust": "node scripts/test-rust.mjs",
    "test:checks": "node --test \"scripts/**/*.check.mjs\"",
    "test:resources": "node --test scripts/browser/run-resources.test.mjs",
    "test:browser": "node scripts/browser/run.mjs",
    "build": "npm run typecheck && vite build",
    "build:demo": "npm run typecheck && node scripts/browser/build.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "marked": "^18.1.1",
    "naive-ui": "^2.45.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "css-tree": "^3.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
