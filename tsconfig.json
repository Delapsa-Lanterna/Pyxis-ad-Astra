{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "preserve",
    "types": ["vite/client"]
  },
  "vueCompilerOptions": {
    "strictTemplates": true,
    "checkUnknownProps": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "schemas/**/*.json"],
  "exclude": ["src/**/*.spec.ts", "src/test/unit/**"]
}
