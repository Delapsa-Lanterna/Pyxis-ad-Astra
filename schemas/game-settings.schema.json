{
  "$schema": "circinus-ad-astra/field-schema/v1",
  "id": "game-settings",
  "gameVersion": "0.98a-RC8",
  "displayName": "游戏设置",
  "sources": [{ "id": "file", "type": "json-file", "path": "data/config/settings.json" }],
  "root": {
    "key": "file",
    "type": "object",
    "label": "设置",
    "nested": [
      {
        "key": "designTypeColors",
        "type": "object",
        "label": "设计类型颜色",
        "valueSchema": {
          "key": "color",
          "type": "color-rgba",
          "label": "颜色",
          "default": [255, 255, 255, 255]
        },
        "allowExtraFields": true
      },
      {
        "key": "graphics",
        "type": "object",
        "label": "图像资源",
        "valueSchema": {
          "key": "category",
          "type": "object",
          "label": "资源类别",
          "default": {},
          "valueSchema": {
            "key": "resource",
            "type": "path-image",
            "label": "图片",
            "default": "",
            "variants": [
              { "type": "path-image" },
              {
                "type": "array",
                "label": "图片列表",
                "default": [],
                "item": {
                  "key": "image",
                  "type": "path-image",
                  "label": "图片",
                  "default": ""
                }
              }
            ]
          },
          "allowExtraFields": true
        },
        "allowExtraFields": true
      },
      {
        "key": "plugins",
        "type": "object",
        "label": "插件",
        "valueSchema": {
          "key": "className",
          "type": "string",
          "label": "插件类名",
          "default": ""
        },
        "allowExtraFields": true
      }
    ],
    "presentation": "groups",
    "valueSchema": {
      "key": "setting",
      "type": "object",
      "label": "分组",
      "default": {},
      "variants": [
        {
          "key": "group",
          "type": "object",
          "label": "分组",
          "default": {},
          "allowExtraFields": true
        },
        { "key": "value", "type": "json", "label": "内容", "default": null }
      ]
    },
    "allowExtraFields": true
  }
}
