{
  "$schema": "pyxis-ad-astra/field-schema/v1",
  "id": "skin",
  "fileType": "skin",
  "displayName": "舰船皮肤",
  "description": "Starsector .skin 舰船皮肤文件",
  "sections": [
    {
      "id": "basic",
      "label": "基础",
      "fields": [
        {
          "key": "skinHullId",
          "type": "string",
          "label": "皮肤 ID",
          "identity": true,
          "required": true
        },
        {
          "key": "baseHullId",
          "type": "enum",
          "label": "基础船体 ID",
          "required": true,
          "source": "csv:ships.id"
        },
        {
          "key": "hullName",
          "type": "string",
          "label": "船体名称"
        },
        {
          "key": "hullDesignation",
          "type": "string",
          "label": "定位"
        },
        {
          "key": "descriptionId",
          "type": "enum",
          "label": "覆盖描述 ID",
          "source": "csv:descriptions.id"
        },
        {
          "key": "descriptionPrefix",
          "type": "string",
          "label": "描述前缀"
        },
        {
          "key": "manufacturer",
          "type": "string",
          "label": "制造商"
        },
        {
          "key": "tech",
          "type": "enum",
          "label": "设计类型",
          "source": "config:designTypes"
        },
        {
          "key": "spriteName",
          "type": "path-image",
          "imageDirectories": [
            "graphics/ships"
          ],
          "label": "贴图路径"
        }
      ]
    },
    {
      "id": "flags",
      "label": "标签与规则",
      "fields": [
        {
          "key": "tags",
          "type": "tag-select",
          "label": "标签",
          "source": "csv:ships.tags"
        },
        {
          "key": "removeHints",
          "type": "string-array",
          "label": "移除 Hints 标记"
        },
        {
          "key": "addHints",
          "type": "string-array",
          "label": "添加 Hints 标记"
        },
        {
          "key": "restoreToBaseHull",
          "type": "boolean",
          "label": "可恢复为基础船体"
        },
        {
          "key": "incompatibleWithBaseHull",
          "type": "boolean",
          "label": "与基础船体不兼容"
        }
      ]
    },
    {
      "id": "stats",
      "label": "数值覆盖",
      "fields": [
        {
          "key": "fpMod",
          "type": "integer",
          "label": "舰队点数增量"
        },
        {
          "key": "baseValue",
          "type": "integer",
          "label": "基础价值",
          "min": 0
        },
        {
          "key": "fleetPoints",
          "type": "integer",
          "label": "舰队点数",
          "min": 0
        },
        {
          "key": "ordnancePoints",
          "type": "integer",
          "label": "装配点数",
          "min": 0
        },
        {
          "key": "baseValueMult",
          "type": "float",
          "label": "基础价值倍数",
          "min": 0,
          "step": 0.05
        },
        {
          "key": "parts/dmod",
          "type": "integer",
          "label": "单项 D 类损伤修复零件",
          "description": "覆盖每项 D 类损伤的修复零件数。继承链尚未显式设置费用时，费用按当前基础价值重新计算，首次显式设置至少为 1。",
          "min": -2147483648,
          "max": 2147483647
        },
        {
          "key": "salary",
          "type": "integer",
          "label": "固定船员月薪",
          "description": "覆盖整艘舰船的固定基础船员月薪。此层同时设置维护消耗或工资倍率时，优先采用此固定工资。",
          "min": -2147483648,
          "max": 2147483647
        },
        {
          "key": "salMult",
          "type": "float",
          "label": "船员工资倍率",
          "step": 0.05,
          "description": "覆盖基础工资倍率。此层设置 salMult 或 suppliesPerMonth 时，工资按对应舰级的工资系数、维护消耗和倍率重新计算；salary 具有优先权。"
        },
        {
          "key": "suppliesToRecover",
          "type": "integer",
          "label": "战备恢复成本 (补给)",
          "min": 0
        },
        {
          "key": "suppliesPerMonth",
          "type": "integer",
          "label": "维护消耗 (补给/月)",
          "min": 0
        },
        {
          "key": "fighterBays",
          "type": "integer",
          "label": "战机甲板数量",
          "min": 0
        },
        {
          "key": "maxSpeed",
          "type": "float",
          "label": "最高航速"
        },
        {
          "key": "shieldEfficiency",
          "type": "float",
          "label": "护盾效率",
          "min": 0,
          "step": 0.05
        }
      ]
    },
    {
      "id": "mods",
      "label": "插件",
      "fields": [
        {
          "key": "builtInMods",
          "type": "string-array",
          "label": "内置插件",
          "source": "csv:hullmods.id"
        },
        {
          "key": "removeBuiltInMods",
          "type": "string-array",
          "label": "移除内置插件",
          "source": "csv:hullmods.id"
        }
      ]
    },
    {
      "id": "weapons",
      "label": "武器",
      "fields": [
        {
          "key": "builtInWeapons",
          "type": "object",
          "label": "内置武器",
          "valueSchema": {
            "key": "weaponId",
            "type": "enum",
            "label": "weapon",
            "source": "csv:weapons.id"
          },
          "allowExtraFields": true
        },
        {
          "key": "removeBuiltInWeapons",
          "type": "string-array",
          "label": "移除内置武器",
          "source": "hull:builtInWeaponSlots"
        },
        {
          "key": "removeWeaponSlots",
          "type": "string-array",
          "label": "移除武器槽"
        },
        {
          "key": "weaponSlotChanges",
          "type": "object",
          "label": "改变武器槽",
          "valueSchema": {
            "key": "slot",
            "type": "object",
            "label": "slot",
            "nested": [
              {
                "key": "type",
                "type": "enum",
                "label": "类型",
                "options": [
                  "BALLISTIC",
                  "ENERGY",
                  "MISSILE",
                  "HYBRID",
                  "UNIVERSAL",
                  "SYNERGY",
                  "COMPOSITE",
                  "BUILT_IN",
                  "DECORATIVE",
                  "SYSTEM",
                  "STATION_MODULE",
                  "LAUNCH_BAY"
                ]
              },
              {
                "key": "size",
                "type": "enum",
                "label": "大小",
                "options": [
                  "SMALL",
                  "MEDIUM",
                  "LARGE"
                ]
              },
              {
                "key": "mount",
                "type": "enum",
                "label": "安装方式",
                "options": [
                  "TURRET",
                  "HARDPOINT",
                  "HIDDEN"
                ]
              },
              {
                "key": "angle",
                "type": "float",
                "label": "角度"
              },
              {
                "key": "arc",
                "type": "float",
                "label": "射界"
              }
            ]
          },
          "allowExtraFields": true
        }
      ]
    },
    {
      "id": "wings",
      "label": "战机联队",
      "fields": [
        {
          "key": "builtInWings",
          "type": "array",
          "label": "内置战机联队",
          "item": {
            "key": "wingId",
            "type": "enum",
            "label": "战机联队 ID",
            "source": "csv:wings.id",
            "default": ""
          }
        }
      ]
    },
    {
      "id": "system",
      "label": "战术系统与视觉",
      "fields": [
        {
          "key": "systemId",
          "type": "enum",
          "label": "战术系统 ID",
          "source": "csv:shipSystems.id"
        },
        {
          "key": "coversColor",
          "type": "color-rgba",
          "label": "武器盖板颜色"
        }
      ]
    },
    {
      "id": "engines",
      "label": "引擎槽",
      "fields": [
        {
          "key": "removeEngineSlots",
          "type": "array",
          "label": "移除引擎槽",
          "item": {
            "key": "engineSlotIndex",
            "type": "integer",
            "label": "引擎槽索引",
            "min": 0,
            "default": 0
          }
        },
        {
          "key": "engineSlotChanges",
          "type": "object",
          "label": "改变引擎槽",
          "valueSchema": {
            "key": "engine",
            "type": "object",
            "label": "engine",
            "nested": [
              {
                "key": "style",
                "type": "string",
                "label": "风格"
              },
              {
                "key": "length",
                "type": "float",
                "label": "长度"
              },
              {
                "key": "width",
                "type": "float",
                "label": "宽度"
              },
              {
                "key": "angle",
                "type": "float",
                "label": "角度"
              }
            ]
          },
          "keySchema": {
            "key": "index",
            "label": "引擎槽索引",
            "type": "integer",
            "min": 0,
            "default": 0
          },
          "allowExtraFields": true
        }
      ]
    }
  ]
}
