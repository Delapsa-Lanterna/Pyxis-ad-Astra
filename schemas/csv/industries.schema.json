{
  "$schema": "pyxis-ad-astra/csv-columns/v1",
  "table": "industries",
  "columns": [
    {
      "key": "id",
      "summary": true,
      "label": "ID",
      "control": "text"
    },
    {
      "key": "name",
      "summary": true,
      "label": "名称",
      "control": "text"
    },
    {
      "key": "cost mult",
      "summary": true,
      "label": "成本倍数",
      "control": "number",
      "step": 0.1
    },
    {
      "key": "build time",
      "summary": true,
      "label": "建造时间",
      "control": "number",
      "step": 1
    },
    {
      "key": "income",
      "label": "收入",
      "control": "number",
      "step": 1
    },
    {
      "key": "upkeep",
      "summary": true,
      "label": "维护费",
      "control": "number",
      "step": 1
    },
    {
      "key": "downgrade",
      "summary": true,
      "label": "降级为",
      "control": "reference",
      "source": "csv:industries.id"
    },
    {
      "key": "upgrade",
      "summary": true,
      "label": "升级为",
      "control": "reference",
      "source": "csv:industries.id"
    },
    {
      "key": "tags",
      "summary": true,
      "label": "Tags 标签",
      "control": "tags",
      "source": "csv:industries.tags",
      "optionCatalog": "industry-tags",
      "suggestions": [
        "codex_unlockable",
        "hide_in_codex",
        "invisible_in_codex",
        "battlestation",
        "command",
        "cryorevival",
        "cryosanctum",
        "farming",
        "fuelprod",
        "grounddefenses",
        "heavyindustry",
        "important",
        "industrial",
        "industry",
        "lightindustry",
        "mining",
        "no_saturation_bombardment",
        "parent_item",
        "patrol",
        "population",
        "refining",
        "rural",
        "spaceport",
        "starfortress",
        "station",
        "structure",
        "sub_item",
        "tactical_bombardment",
        "techmining",
        "unraidable",
        "urban",
        "uses_blueprints",
        "waystation",
        "do_not_show_in_build_dialog",
        "military"
      ]
    },
    {
      "key": "data",
      "label": "数据",
      "control": "text"
    },
    {
      "key": "image",
      "label": "图标",
      "control": "path-image",
      "imageDirectories": [
        "graphics/icons/industry"
      ]
    },
    {
      "key": "plugin",
      "label": "插件",
      "control": "text"
    },
    {
      "key": "desc",
      "label": "描述",
      "control": "text"
    },
    {
      "key": "order",
      "label": "排序",
      "control": "number",
      "step": 1
    },
    {
      "key": "disruptDanger",
      "summary": true,
      "label": "破坏危险度",
      "control": "enum",
      "options": [
        "NONE",
        "MINIMAL",
        "LOW",
        "MEDIUM",
        "HIGH",
        "EXTREME"
      ],
      "optionCatalog": "raid-danger-levels"
    }
  ],
  "validation": {
    "requiredColumn": [
      "id",
      "name",
      "plugin"
    ],
    "warningMin": {
      "cost mult": 0,
      "build time": 0,
      "upkeep": 0
    },
    "required": [
      "plugin"
    ],
    "script": [
      "plugin"
    ],
    "integer": [
      "order"
    ]
  }
}
