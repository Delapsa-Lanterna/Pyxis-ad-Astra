{
  "$schema": "pyxis-ad-astra/csv-columns/v1",
  "table": "marketConditions",
  "columns": [
    {
      "key": "name",
      "summary": true,
      "label": "名称",
      "control": "text"
    },
    {
      "key": "id",
      "summary": true,
      "label": "ID",
      "control": "text"
    },
    {
      "key": "tags",
      "summary": true,
      "label": "Tags 标签",
      "control": "tags",
      "source": "csv:marketConditions.tags"
    },
    {
      "key": "planetary",
      "summary": true,
      "label": "行星",
      "control": "boolean"
    },
    {
      "key": "decivRemove",
      "summary": true,
      "label": "文明丧失时移除",
      "control": "boolean"
    },
    {
      "key": "script",
      "label": "脚本",
      "control": "text"
    },
    {
      "key": "desc",
      "label": "描述",
      "control": "text"
    },
    {
      "key": "icon",
      "label": "图标",
      "control": "path-image",
      "imageDirectories": [
        "graphics/icons/markets"
      ]
    },
    {
      "key": "order",
      "label": "排序",
      "control": "number",
      "step": 1
    }
  ],
  "validation": {
    "requiredColumn": [
      "name",
      "id",
      "script",
      "icon"
    ],
    "required": [
      "script"
    ],
    "script": [
      "script"
    ]
  }
}
