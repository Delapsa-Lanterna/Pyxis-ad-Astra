{
  "$schema": "pyxis-ad-astra/csv-columns/v1",
  "table": "specialItems",
  "columns": [
    {
      "key": "name",
      "summary": true,
      "label": "名称",
      "control": "text"
    },
    {
      "key": "id",
      "summary": true,
      "label": "ID",
      "control": "text"
    },
    {
      "key": "tags",
      "summary": true,
      "label": "Tags 标签",
      "control": "tags",
      "source": "csv:specialItems.tags"
    },
    {
      "key": "tech/manufacturer",
      "summary": true,
      "label": "设计类型",
      "control": "reference",
      "source": "config:designTypes"
    },
    {
      "key": "rarity",
      "label": "稀有度",
      "control": "number",
      "step": 0.1
    },
    {
      "key": "base price",
      "summary": true,
      "label": "基础价格",
      "control": "number",
      "step": 1
    },
    {
      "key": "stack size",
      "label": "堆叠数量",
      "control": "number",
      "step": 1
    },
    {
      "key": "cargo space",
      "label": "货舱占用",
      "control": "number",
      "step": 1
    },
    {
      "key": "baseRaidDanger",
      "summary": true,
      "label": "袭击风险",
      "control": "enum",
      "options": [
        "NONE",
        "MINIMAL",
        "LOW",
        "MEDIUM",
        "HIGH",
        "EXTREME"
      ]
    },
    {
      "key": "icon",
      "label": "图标",
      "control": "path-image",
      "imageDirectories": [
        "graphics/icons/cargo"
      ]
    },
    {
      "key": "sound id",
      "label": "拾取音效",
      "control": "reference",
      "source": "config:sounds"
    },
    {
      "key": "sound id drop",
      "label": "丢弃音效",
      "control": "reference",
      "source": "config:sounds"
    },
    {
      "key": "plugin",
      "label": "插件",
      "control": "text"
    },
    {
      "key": "plugin params",
      "label": "插件参数",
      "control": "text"
    },
    {
      "key": "desc",
      "label": "描述",
      "control": "text"
    },
    {
      "key": "order",
      "label": "排序",
      "control": "number",
      "step": 1
    }
  ],
  "validation": {
    "requiredColumn": [
      "name",
      "id",
      "icon",
      "sound id",
      "sound id drop",
      "plugin",
      "plugin params",
      "desc"
    ],
    "warningMin": {
      "rarity": 0,
      "base price": 0,
      "stack size": 5e-324,
      "cargo space": 0
    },
    "integer": [
      "stack size"
    ],
    "required": [
      "stack size",
      "plugin",
      "order"
    ],
    "script": [
      "plugin"
    ]
  }
}
