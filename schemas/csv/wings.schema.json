{
  "$schema": "pyxis-ad-astra/csv-columns/v1",
  "table": "wings",
  "columns": [
    {
      "key": "id",
      "summary": true,
      "label": "ID",
      "control": "text"
    },
    {
      "key": "variant",
      "summary": true,
      "label": "装配",
      "control": "reference",
      "source": "csv:variants.variantId"
    },
    {
      "key": "tags",
      "summary": true,
      "label": "Tags 标签",
      "control": "tags",
      "source": "csv:wings.tags"
    },
    {
      "key": "tier",
      "label": "级别",
      "control": "number",
      "step": 1
    },
    {
      "key": "rarity",
      "label": "稀有度",
      "control": "number",
      "step": 0.01
    },
    {
      "key": "fleet pts",
      "label": "舰队点数",
      "control": "number",
      "step": 1
    },
    {
      "key": "op cost",
      "summary": true,
      "label": "装配点数",
      "control": "number",
      "step": 1
    },
    {
      "key": "formation",
      "summary": true,
      "label": "阵型",
      "control": "enum",
      "options": [
        "CLAW",
        "V",
        "BOX",
        "DIAMOND"
      ]
    },
    {
      "key": "range",
      "label": "作战范围",
      "control": "number",
      "step": 1
    },
    {
      "key": "attackRunRange",
      "label": "攻击距离",
      "control": "number",
      "step": 1
    },
    {
      "key": "attackPositionOffset",
      "label": "攻击位置偏移",
      "control": "number",
      "step": 1
    },
    {
      "key": "num",
      "summary": true,
      "label": "联队战机数量",
      "control": "number",
      "step": 1
    },
    {
      "key": "role",
      "summary": true,
      "label": "战术应用",
      "control": "enum",
      "options": [
        "FIGHTER",
        "INTERCEPTOR",
        "BOMBER",
        "ASSAULT",
        "SUPPORT"
      ]
    },
    {
      "key": "role desc",
      "label": "战术应用说明",
      "control": "text"
    },
    {
      "key": "refit",
      "summary": true,
      "label": "战机更换时间 (秒)",
      "control": "number",
      "step": 0.1
    },
    {
      "key": "base value",
      "label": "基础价值",
      "control": "number",
      "step": 1
    },
    {
      "key": "number",
      "label": "编号",
      "control": "number",
      "step": 1
    }
  ],
  "validation": {
    "requiredColumn": [
      "id",
      "variant",
      "role desc"
    ],
    "required": [
      "variant",
      "formation",
      "num",
      "role",
      "refit"
    ],
    "integer": [
      "tier",
      "fleet pts",
      "num",
      "base value"
    ],
    "warningMin": {
      "tier": 0,
      "rarity": 0,
      "fleet pts": 0,
      "op cost": 0,
      "range": 0,
      "attackRunRange": 0,
      "num": 5e-324,
      "refit": 0,
      "base value": 0
    }
  }
}
