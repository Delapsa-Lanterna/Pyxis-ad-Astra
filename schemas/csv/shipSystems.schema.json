{
  "$schema": "pyxis-ad-astra/csv-columns/v1",
  "table": "shipSystems",
  "columns": [
    {
      "key": "name",
      "summary": true,
      "label": "名称",
      "control": "text"
    },
    {
      "key": "id",
      "summary": true,
      "label": "ID",
      "control": "text"
    },
    {
      "key": "flux/second",
      "label": "幅能/秒",
      "control": "number",
      "step": 0.1
    },
    {
      "key": "f/s (base rate)",
      "label": "每秒幅能 (耗散系数)",
      "control": "number",
      "step": 0.1
    },
    {
      "key": "f/s (base cap)",
      "label": "每秒幅能 (容量系数)",
      "control": "number",
      "step": 0.1
    },
    {
      "key": "flux/use",
      "label": "每次幅能",
      "control": "number",
      "step": 0.1
    },
    {
      "key": "f/u (base rate)",
      "label": "单次幅能 (耗散系数)",
      "control": "number",
      "step": 0.1
    },
    {
      "key": "f/u (base cap)",
      "label": "单次幅能 (容量系数)",
      "control": "number",
      "step": 0.1
    },
    {
      "key": "cr/u",
      "label": "每次 CR",
      "control": "number",
      "step": 0.1
    },
    {
      "key": "max uses",
      "summary": true,
      "label": "最大次数",
      "control": "number",
      "step": 1
    },
    {
      "key": "regen",
      "summary": true,
      "label": "恢复",
      "control": "number",
      "step": 0.1
    },
    {
      "key": "charge up",
      "label": "渐入",
      "control": "number",
      "step": 0.1
    },
    {
      "key": "active",
      "summary": true,
      "label": "持续",
      "control": "number",
      "step": 0.1
    },
    {
      "key": "down",
      "label": "渐出",
      "control": "number",
      "step": 0.1
    },
    {
      "key": "cooldown",
      "summary": true,
      "label": "冷却",
      "control": "number",
      "step": 0.1
    },
    {
      "key": "toggle",
      "label": "切换",
      "control": "boolean"
    },
    {
      "key": "noDissipation",
      "label": "禁止耗散",
      "control": "boolean"
    },
    {
      "key": "noHardDissipation",
      "label": "禁止硬幅能耗散",
      "control": "boolean"
    },
    {
      "key": "hardFlux",
      "label": "产生硬幅能",
      "control": "boolean"
    },
    {
      "key": "noFiring",
      "label": "禁止开火",
      "control": "boolean"
    },
    {
      "key": "noTurning",
      "label": "禁止转向",
      "control": "boolean"
    },
    {
      "key": "noStrafing",
      "label": "禁止横移",
      "control": "boolean"
    },
    {
      "key": "noAccel",
      "label": "禁止加速",
      "control": "boolean"
    },
    {
      "key": "noShield",
      "label": "禁止护盾",
      "control": "boolean"
    },
    {
      "key": "noVent",
      "label": "禁止强制排散",
      "control": "boolean"
    },
    {
      "key": "isPhaseCloak",
      "label": "视作相位",
      "control": "boolean"
    },
    {
      "key": "tags",
      "summary": true,
      "label": "Tags 标签",
      "control": "tags",
      "source": "csv:shipSystems.tags"
    },
    {
      "key": "icon",
      "label": "图标",
      "control": "path-image",
      "imageDirectories": [
        "graphics/icons/hullsys"
      ]
    }
  ],
  "validation": {
    "requiredColumn": [
      "name",
      "id"
    ],
    "warningMin": {
      "flux/second": 0,
      "f/s (base rate)": 0,
      "f/s (base cap)": 0,
      "flux/use": 0,
      "f/u (base rate)": 0,
      "f/u (base cap)": 0,
      "cr/u": 0,
      "max uses": 0,
      "regen": 0,
      "charge up": 0,
      "active": 0,
      "down": 0,
      "cooldown": 0
    },
    "integer": [
      "max uses"
    ]
  }
}
