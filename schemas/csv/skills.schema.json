{
  "$schema": "pyxis-ad-astra/csv-columns/v1",
  "table": "skills",
  "columns": [
    {
      "key": "id",
      "summary": true,
      "label": "ID",
      "control": "text"
    },
    {
      "key": "name",
      "summary": true,
      "label": "名称",
      "control": "text"
    },
    {
      "key": "order",
      "label": "排序",
      "control": "number",
      "step": 1
    },
    {
      "key": "tier",
      "label": "层级",
      "control": "number",
      "step": 1
    },
    {
      "key": "reqPoints",
      "summary": true,
      "label": "所需点数",
      "control": "number",
      "step": 1
    },
    {
      "key": "reqPointsPerExtraSkill",
      "label": "额外技能点数",
      "control": "number",
      "step": 1
    },
    {
      "key": "description",
      "label": "描述",
      "control": "text"
    },
    {
      "key": "author",
      "label": "作者",
      "control": "text"
    },
    {
      "key": "combat officer",
      "summary": true,
      "label": "战斗军官",
      "control": "boolean"
    },
    {
      "key": "admiral",
      "summary": true,
      "label": "指挥官",
      "control": "boolean"
    },
    {
      "key": "admin",
      "summary": true,
      "label": "行政官",
      "control": "boolean"
    },
    {
      "key": "tags",
      "summary": true,
      "label": "Tags 标签",
      "control": "tags",
      "source": "csv:skills.tags"
    },
    {
      "key": "icon",
      "label": "图标",
      "control": "path-image",
      "imageDirectories": [
        "graphics/icons/skills"
      ]
    }
  ],
  "validation": {
    "requiredColumn": [
      "id",
      "name",
      "description",
      "icon"
    ],
    "required": [
      "order"
    ],
    "integer": [
      "tier",
      "reqPoints",
      "reqPointsPerExtraSkill"
    ],
    "warningMin": {
      "tier": 0,
      "reqPoints": 0,
      "reqPointsPerExtraSkill": 0
    }
  }
}
