{
  "$schema": "pyxis-ad-astra/csv-columns/v1",
  "table": "weapons",
  "columns": [
    { "key": "name", "label": "名称", "control": "text" },
    { "key": "id", "label": "ID", "control": "text" },
    { "key": "tier", "label": "级别", "control": "number", "step": 1 },
    { "key": "rarity", "label": "稀有度", "control": "number", "step": 0.01 },
    { "key": "base value", "label": "基础价值", "control": "number", "step": 1 },
    { "key": "range", "label": "武器射程", "control": "number", "step": 1 },
    { "key": "damage/second", "label": "每秒伤害", "control": "number", "step": 0.1 },
    { "key": "damage/shot", "label": "每发伤害", "control": "number", "step": 1 },
    { "key": "emp", "label": "EMP", "control": "number", "step": 1 },
    { "key": "impact", "label": "冲击", "control": "number", "step": 1 },
    { "key": "turn rate", "label": "转向速度", "control": "number", "step": 1 },
    { "key": "OPs", "label": "装配点数", "control": "number", "step": 1 },
    { "key": "ammo", "label": "备弹量", "control": "number", "step": 1 },
    { "key": "ammo/sec", "label": "备弹恢复/秒", "control": "number", "step": 0.1 },
    { "key": "reload size", "label": "单次装填量", "control": "number", "step": 1 },
    {
      "key": "type",
      "label": "伤害类型",
      "control": "enum",
      "options": ["KINETIC", "ENERGY", "HIGH_EXPLOSIVE", "FRAGMENTATION"]
    },
    { "key": "energy/shot", "label": "每发幅能", "control": "number", "step": 1 },
    { "key": "energy/second", "label": "每秒幅能", "control": "number", "step": 0.1 },
    { "key": "chargeup", "label": "充能时间", "control": "number", "step": 0.1 },
    { "key": "chargedown", "label": "渐出时间", "control": "number", "step": 0.1 },
    { "key": "burst size", "label": "每轮发射数／光束时长", "control": "number", "step": 0.1 },
    { "key": "burst delay", "label": "连发间隔", "control": "number", "step": 0.1 },
    { "key": "min spread", "label": "最小散布", "control": "number", "step": 0.1 },
    { "key": "max spread", "label": "最大散布", "control": "number", "step": 0.1 },
    { "key": "spread/shot", "label": "每发散布", "control": "number", "step": 0.1 },
    { "key": "spread decay/sec", "label": "散布衰减/秒", "control": "number", "step": 0.1 },
    { "key": "beam speed", "label": "光束速度", "control": "number", "step": 1 },
    { "key": "proj speed", "label": "弹体速度", "control": "number", "step": 1 },
    { "key": "launch speed", "label": "发射速度", "control": "number", "step": 1 },
    { "key": "flight time", "label": "飞行时间", "control": "number", "step": 0.1 },
    { "key": "proj hitpoints", "label": "弹体结构值", "control": "number", "step": 1 },
    { "key": "autofireAccBonus", "label": "自动开火精确度加成", "control": "number", "step": 0.1 },
    { "key": "extraArcForAI", "label": "AI 额外射界", "control": "number", "step": 1 },
    { "key": "hints", "label": "Hints 提示", "control": "tags", "source": "csv:weapons.hints" },
    { "key": "tags", "label": "Tags 标签", "control": "tags", "source": "csv:weapons.tags" },
    { "key": "groupTag", "label": "分组标签", "control": "text" },
    { "key": "tech/manufacturer", "label": "设计类型", "control": "reference", "source": "config:designTypes" },
    { "key": "for weapon tooltip>>", "label": "此后为提示文本", "control": "text" },
    { "key": "primaryRoleStr", "label": "战术应用", "control": "text" },
    { "key": "speedStr", "label": "飞行速度描述", "control": "text" },
    { "key": "trackingStr", "label": "追踪能力描述", "control": "text" },
    { "key": "turnRateStr", "label": "转向描述", "control": "text" },
    { "key": "accuracyStr", "label": "精确度描述", "control": "text" },
    { "key": "customPrimary", "label": "自定义主文本", "control": "text" },
    { "key": "customPrimaryHL", "label": "主文本高亮", "control": "text" },
    { "key": "customAncillary", "label": "自定义副文本", "control": "text" },
    { "key": "customAncillaryHL", "label": "副文本高亮", "control": "text" },
    { "key": "noDPSInTooltip", "label": "隐藏 DPS", "control": "boolean" },
    { "key": "number", "label": "编号", "control": "number", "step": 1 }
  ]
}
