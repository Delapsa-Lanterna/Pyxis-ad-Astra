{
  "$schema": "pyxis-ad-astra/csv-columns/v1",
  "table": "submarkets",
  "columns": [
    {
      "key": "id",
      "summary": true,
      "label": "ID",
      "control": "text"
    },
    {
      "key": "name",
      "summary": true,
      "label": "名称",
      "control": "text"
    },
    {
      "key": "faction",
      "label": "势力",
      "control": "reference",
      "source": "csv:factions.id"
    },
    {
      "key": "desc",
      "label": "描述",
      "control": "text"
    },
    {
      "key": "script",
      "label": "脚本",
      "control": "text"
    },
    {
      "key": "icon",
      "label": "图标",
      "control": "path-image",
      "imageDirectories": [
        "graphics/factions"
      ]
    },
    {
      "key": "order",
      "label": "排序",
      "control": "number",
      "step": 1
    }
  ],
  "validation": {
    "requiredColumn": [
      "id",
      "name",
      "faction",
      "script",
      "icon"
    ],
    "required": [
      "script",
      "order"
    ],
    "script": [
      "script"
    ]
  }
}
