{
  "$schema": "pyxis-ad-astra/csv-columns/v1",
  "table": "hullmods",
  "columns": [
    {
      "key": "name",
      "summary": true,
      "label": "名称",
      "control": "text"
    },
    {
      "key": "id",
      "summary": true,
      "label": "ID",
      "control": "text"
    },
    {
      "key": "tier",
      "label": "级别",
      "control": "number",
      "step": 1
    },
    {
      "key": "rarity",
      "label": "稀有度",
      "control": "number",
      "step": 0.01
    },
    {
      "key": "tech/manufacturer",
      "summary": true,
      "label": "设计类型",
      "control": "reference",
      "source": "config:designTypes"
    },
    {
      "key": "tags",
      "summary": true,
      "label": "Tags 标签",
      "control": "tags",
      "source": "csv:hullmods.tags"
    },
    {
      "key": "uiTags",
      "label": "UI 标签",
      "control": "tags",
      "source": "csv:hullmods.uiTags"
    },
    {
      "key": "base value",
      "label": "基础价值",
      "control": "number",
      "step": 1
    },
    {
      "key": "unlocked",
      "label": "已解锁",
      "control": "boolean"
    },
    {
      "key": "hidden",
      "label": "隐藏",
      "control": "boolean"
    },
    {
      "key": "hiddenEverywhere",
      "label": "完全隐藏",
      "control": "boolean"
    },
    {
      "key": "cost_frigate",
      "summary": true,
      "label": "护卫舰装配点数",
      "control": "number",
      "step": 1
    },
    {
      "key": "cost_dest",
      "summary": true,
      "label": "驱逐舰装配点数",
      "control": "number",
      "step": 1
    },
    {
      "key": "cost_cruiser",
      "summary": true,
      "label": "巡洋舰装配点数",
      "control": "number",
      "step": 1
    },
    {
      "key": "cost_capital",
      "summary": true,
      "label": "主力舰装配点数",
      "control": "number",
      "step": 1
    },
    {
      "key": "script",
      "label": "脚本",
      "control": "text"
    },
    {
      "key": "desc",
      "label": "描述",
      "control": "text"
    },
    {
      "key": "short",
      "label": "简短描述",
      "control": "text"
    },
    {
      "key": "sModDesc",
      "label": "S 插件强化说明",
      "control": "text"
    },
    {
      "key": "sprite",
      "label": "图标",
      "control": "path-image",
      "imageDirectories": [
        "graphics/hullmods"
      ]
    }
  ],
  "validation": {
    "requiredColumn": [
      "name",
      "id",
      "script"
    ],
    "integer": [
      "tier",
      "cost_frigate",
      "cost_dest",
      "cost_cruiser",
      "cost_capital"
    ],
    "warningMin": {
      "tier": 0,
      "rarity": 0,
      "base value": 0,
      "cost_frigate": 0,
      "cost_dest": 0,
      "cost_cruiser": 0,
      "cost_capital": 0
    },
    "required": [
      "cost_frigate",
      "cost_dest",
      "cost_cruiser",
      "cost_capital",
      "script"
    ],
    "script": [
      "script"
    ]
  }
}
