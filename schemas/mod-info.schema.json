{
  "$schema": "circinus-ad-astra/field-schema/v1",
  "id": "mod-info",
  "fileType": "mod_info.json",
  "displayName": "Mod 信息",
  "description": "Mod 的基本元数据定义文件，包含 ID、名称、版本、依赖等信息",
  "sections": [
    {
      "id": "__all",
      "label": "Mod 信息",
      "fields": [
        {
          "key": "file.id",
          "type": "string",
          "label": "Mod ID",
          "description": "Mod 的唯一标识符，用于依赖引用和内部识别",
          "required": true,
          "editable": true,
          "danger": "修改 ID 会导致存档不兼容"
        },
        {
          "key": "file.name",
          "type": "string",
          "label": "Mod 名称",
          "description": "Mod 的显示名称",
          "required": true,
          "editable": true
        },
        {
          "key": "file.author",
          "type": "string",
          "label": "作者",
          "description": "Mod 作者名称",
          "required": false,
          "editable": true
        },
        {
          "key": "file.version",
          "type": "string",
          "label": "版本号",
          "description": "支持版本字符串或包含 major、minor、patch 的对象；对象中的各部分保留原有的数字或文字类型。",
          "required": true,
          "editable": true,
          "default": "1.0.0",
          "variants": [
            { "type": "string" },
            {
              "type": "object",
              "nested": [
                {
                  "key": "major",
                  "type": "string",
                  "label": "主版本",
                  "required": true,
                  "variants": [{ "type": "string" }, { "type": "float" }]
                },
                {
                  "key": "minor",
                  "type": "string",
                  "label": "次版本",
                  "variants": [{ "type": "string" }, { "type": "float" }]
                },
                {
                  "key": "patch",
                  "type": "string",
                  "label": "修订版本",
                  "variants": [{ "type": "string" }, { "type": "float" }]
                }
              ]
            }
          ]
        },
        {
          "key": "file.gameVersion",
          "type": "string",
          "label": "游戏版本",
          "description": "Mod 适用的 Starsector 游戏版本",
          "required": true,
          "editable": true,
          "default": "0.98a",
          "variants": [
            { "type": "string" },
            {
              "type": "object",
              "nested": [
                {
                  "key": "major",
                  "type": "string",
                  "label": "主版本",
                  "required": true,
                  "variants": [{ "type": "string" }, { "type": "float" }]
                },
                {
                  "key": "minor",
                  "type": "string",
                  "label": "次版本",
                  "variants": [{ "type": "string" }, { "type": "float" }]
                },
                {
                  "key": "patch",
                  "type": "string",
                  "label": "修订版本",
                  "variants": [{ "type": "string" }, { "type": "float" }]
                }
              ]
            }
          ]
        },
        {
          "key": "file.description",
          "type": "text",
          "label": "描述",
          "description": "Mod 的简要说明，显示在启动器中",
          "required": false,
          "editable": true
        },
        {
          "key": "file.modPlugin",
          "type": "string",
          "label": "Mod 插件类",
          "description": "Mod 的主插件类全限定名 (Java class path)",
          "required": false,
          "editable": true
        },
        {
          "key": "file.jars",
          "type": "string-array",
          "label": "JAR 文件",
          "description": "Mod 需要加载的 JAR 文件路径列表 (相对于 mod 根目录)",
          "required": false,
          "editable": true,
          "default": []
        },
        {
          "key": "file.dependencies",
          "type": "array",
          "label": "依赖项",
          "description": "Mod 所依赖的其他 Mod 列表",
          "required": false,
          "editable": true,
          "default": [],
          "item": {
            "key": "item",
            "label": "依赖项",
            "type": "object",
            "default": { "id": "" },
            "nested": [
              {
                "key": "id",
                "type": "string",
                "label": "依赖 Mod ID",
                "description": "依赖项的 Mod ID",
                "required": true,
                "editable": true
              },
              {
                "key": "name",
                "type": "string",
                "label": "依赖名称",
                "description": "依赖项的显示名称 (可选，仅用于展示)",
                "required": false,
                "editable": true
              },
              {
                "key": "version",
                "type": "string",
                "label": "最低版本",
                "description": "依赖项所需的最低版本",
                "required": false,
                "editable": true,
                "variants": [
                  { "type": "string" },
                  {
                    "type": "object",
                    "nested": [
                      {
                        "key": "major",
                        "type": "string",
                        "label": "主版本",
                        "required": true,
                        "variants": [{ "type": "string" }, { "type": "float" }]
                      },
                      {
                        "key": "minor",
                        "type": "string",
                        "label": "次版本",
                        "variants": [{ "type": "string" }, { "type": "float" }]
                      },
                      {
                        "key": "patch",
                        "type": "string",
                        "label": "修订版本",
                        "variants": [{ "type": "string" }, { "type": "float" }]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "key": "file.totalConversion",
          "type": "boolean",
          "label": "完全独立",
          "description": "是否为完全独立 Mod (会禁用一切非工具类 Mod)",
          "required": false,
          "editable": true,
          "default": false,
          "warning": "启用后该 Mod 将排斥一切非工具类 Mod"
        },
        {
          "key": "file.utility",
          "type": "boolean",
          "label": "工具类 Mod",
          "description": "是否为工具类 Mod (可与完全独立 Mod 共存)",
          "required": false,
          "editable": true,
          "default": false
        },
        {
          "key": "file.replace",
          "type": "string-array",
          "label": "替换文件",
          "description": "需要完全替换 (而非合并) 的文件路径列表",
          "required": false,
          "editable": true,
          "default": [],
          "warning": "替换文件会覆盖原版内容，可能导致与其他 Mod 冲突"
        }
      ]
    }
  ],
  "sources": [{ "id": "file", "type": "json-file", "path": "mod_info.json", "extraFields": true }]
}
