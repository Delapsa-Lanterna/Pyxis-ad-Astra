{
  "$schema": "circinus-ad-astra/field-schema/v1",
  "id": "spec-weapon",
  "sections": [
    {
      "id": "basic",
      "label": "基础属性",
      "fields": [
        { "key": "id", "label": "武器 ID", "type": "string", "default": "", "required": true, "identity": true },
        {
          "key": "specClass",
          "label": "规格类型",
          "type": "enum",
          "default": "",
          "options": ["projectile", "beam"],
          "required": true,
          "ref": "spec-weapon#/definitions/save/nested/0"
        },
        { "key": "type", "label": "类型", "type": "enum", "default": "", "required": true, "ref": "spec-weapon#/definitions/enum1" },
        { "key": "size", "label": "尺寸", "type": "enum", "default": "", "options": ["SMALL", "MEDIUM", "LARGE"], "required": true },
        {
          "key": "restrictToSpecifiedMountType",
          "label": "限定指定挂载类型",
          "type": "boolean",
          "default": false,
          "visibleWhen": { "specClass": ["projectile"] }
        }
      ]
    },
    {
      "id": "turretBarrels",
      "label": "炮塔配置",
      "fields": [
        {
          "key": "turretSprite",
          "label": "主体贴图",
          "type": "path-image",
          "imageDirectories": ["graphics/weapons"],
          "default": "",
          "required": true
        },
        { "key": "turretUnderSprite", "label": "底层贴图", "type": "path-image", "imageDirectories": ["graphics/weapons"], "default": "" },
        { "key": "turretGlowSprite", "label": "光效贴图", "type": "path-image", "imageDirectories": ["graphics/weapons"], "default": "" },
        {
          "key": "turretGunSprite",
          "label": "炮管贴图",
          "type": "path-image",
          "imageDirectories": ["graphics/weapons"],
          "default": "",
          "visibleWhen": { "specClass": ["projectile"] }
        }
      ]
    },
    {
      "id": "hardpointBarrels",
      "label": "固定配置",
      "fields": [
        {
          "key": "hardpointSprite",
          "label": "主体贴图",
          "type": "path-image",
          "imageDirectories": ["graphics/weapons"],
          "default": "",
          "required": true
        },
        {
          "key": "hardpointUnderSprite",
          "label": "底层贴图",
          "type": "path-image",
          "imageDirectories": ["graphics/weapons"],
          "default": ""
        },
        {
          "key": "hardpointGlowSprite",
          "label": "光效贴图",
          "type": "path-image",
          "imageDirectories": ["graphics/weapons"],
          "default": ""
        },
        {
          "key": "hardpointGunSprite",
          "label": "炮管贴图",
          "type": "path-image",
          "imageDirectories": ["graphics/weapons"],
          "default": "",
          "visibleWhen": { "specClass": ["projectile"] }
        }
      ]
    },
    {
      "id": "beam",
      "label": "光束参数",
      "visibleWhen": { "specClass": ["beam"] },
      "fields": [
        { "key": "width", "label": "宽度", "type": "float", "default": 10 },
        {
          "key": "textureType",
          "label": "纹理类型",
          "type": "enum",
          "default": "",
          "options": ["SMOOTH", "MEDIUM", "ROUGH", "CHUNKY", "ROUGH2", "WEAVE", "LASER"],
          "required": true,
          "variants": [
            {
              "type": "enum",
              "default": "",
              "options": ["SMOOTH", "MEDIUM", "ROUGH", "CHUNKY", "ROUGH2", "WEAVE", "LASER"],
              "required": true
            },
            {
              "type": "array",
              "label": "自定义纹理",
              "minEntries": 2,
              "maxEntries": 2,
              "item": { "key": "texture", "label": "纹理", "type": "path-image", "imageDirectories": ["graphics/fx"], "required": true }
            }
          ]
        },
        { "key": "textureScrollSpeed", "label": "纹理滚动速度", "type": "float", "default": 64 },
        { "key": "fringeScrollSpeedMult", "label": "外围滚动倍率", "type": "float", "default": 1 },
        { "key": "pixelsPerTexel", "label": "纹素比例", "type": "float", "default": 1 },
        { "key": "fringeColor", "label": "外围颜色", "type": "color-rgba", "default": [255, 255, 255, 255] },
        { "key": "coreColor", "label": "核心颜色", "type": "color-rgba", "default": [255, 255, 255, 255] },
        { "key": "darkCore", "label": "暗色核心", "type": "boolean", "default": false },
        { "key": "darkCoreIter", "label": "暗芯绘制次数", "type": "float", "default": 1 },
        { "key": "darkFringeIter", "label": "外围绘制次数", "type": "float", "default": 1 },
        { "key": "coreWidthMult", "label": "核心宽度倍率", "type": "float", "default": 1 },
        { "key": "randomizeTextureOffset", "label": "随机纹理偏移", "type": "boolean", "default": false },
        { "key": "beamFireOnlyOnFullCharge", "label": "完全充能后发射", "type": "boolean", "default": false },
        { "key": "convergeOnPoint", "label": "汇聚于目标点", "type": "boolean", "default": false },
        { "key": "skipIdleFrameIfZeroBurstDelay", "label": "零连发间隔跳过空闲帧", "type": "boolean", "default": false }
      ]
    },
    {
      "id": "proj",
      "label": "发射设置",
      "visibleWhen": { "specClass": ["projectile"] },
      "fields": [
        {
          "key": "barrelMode",
          "label": "发射模式",
          "type": "enum",
          "default": "",
          "options": ["ALTERNATING", "ALTERNATING_BURST", "DUAL", "LINKED"],
          "required": true
        },
        {
          "key": "projectileSpecId",
          "label": "弹体 ID",
          "type": "enum",
          "default": "",
          "required": true,
          "ref": "spec-projectile#/definitions/projectileReference"
        },
        { "key": "autocharge", "label": "自动充能", "type": "boolean", "default": false },
        { "key": "requiresFullCharge", "label": "需要完全充能", "type": "boolean", "default": true },
        { "key": "interruptibleBurst", "label": "允许中断连发", "type": "boolean", "default": false },
        { "key": "unaffectedByProjectileSpeedBonuses", "label": "忽略弹体速度加成", "type": "boolean", "default": false }
      ]
    },
    {
      "id": "hit",
      "label": "命中效果",
      "visibleWhen": { "specClass": ["beam"] },
      "fields": [
        { "key": "collisionClass", "label": "碰撞类型", "type": "enum", "default": "RAY", "ref": "spec-weapon#/definitions/enum2" },
        {
          "key": "collisionClassByFighter",
          "label": "战机发射时碰撞类型",
          "type": "enum",
          "default": "RAY_FIGHTER",
          "ref": "spec-weapon#/definitions/enum2"
        },
        { "key": "pierceSet", "label": "穿透类型", "type": "string-array", "default": [], "ref": "spec-weapon#/definitions/enum2" },
        { "key": "hitGlowRadius", "label": "命中光晕半径", "type": "float", "default": -1 },
        { "key": "hitGlowBrightenDuration", "label": "命中增亮时间", "type": "float", "default": 1 },
        { "key": "useGlowColorForHitGlow", "label": "命中使用光效颜色", "type": "boolean", "default": false }
      ]
    },
    {
      "id": "muzzle",
      "label": "炮口效果",
      "visibleWhen": { "specClass": ["projectile"] },
      "fields": [
        {
          "key": "animationType",
          "label": "炮口动画类型",
          "type": "enum",
          "default": "",
          "options": ["NONE", "GLOW", "MUZZLE_FLASH", "GLOW_AND_FLASH", "SMOKE"],
          "required": true
        },
        { "key": "visualRecoil", "label": "视觉后坐", "type": "float", "default": 0 },
        { "key": "separateRecoilForLinkedBarrels", "label": "齐射时各炮管独立后坐", "type": "boolean", "default": false }
      ]
    },
    {
      "id": "anim",
      "label": "帧动画",
      "fields": [
        { "key": "numFrames", "label": "帧数", "type": "float", "default": 1 },
        { "key": "frameRate", "label": "帧率", "type": "float", "default": 1 },
        { "key": "alwaysAnimate", "label": "持续播放", "type": "boolean", "default": false },
        { "key": "animateWhileFiring", "label": "开火时播放", "type": "boolean", "default": true }
      ]
    },
    {
      "id": "glow",
      "label": "光效与绘制",
      "fields": [
        { "key": "glowColor", "label": "光效颜色", "type": "color-rgba", "default": [255, 255, 255, 255] },
        { "key": "specialWeaponGlowWidth", "label": "特殊光效宽度", "type": "float", "default": -1 },
        { "key": "specialWeaponGlowHeight", "label": "特殊光效高度", "type": "float", "default": -1 },
        {
          "key": "renderHints",
          "label": "绘制提示",
          "type": "string-array",
          "default": [],
          "options": [
            "RENDER_BARREL_BELOW",
            "RENDER_LOADED_MISSILES",
            "RENDER_LOADED_MISSILES_UNLESS_HIDDEN",
            "RENDER_ADDITIVE",
            "SUSPEND_RECOIL",
            "NEVER_RENDER_IN_CAMPAIGN"
          ]
        },
        { "key": "renderBelowAllWeapons", "label": "绘制于全部武器下方", "type": "boolean", "default": false },
        { "key": "showDamageWhenDecorative", "label": "装饰类型显示伤害", "type": "boolean", "default": false },
        {
          "key": "renderAboveAllWeapons",
          "label": "绘制于全部武器上方",
          "type": "boolean",
          "default": false,
          "visibleWhen": { "specClass": ["projectile"] }
        }
      ]
    },
    {
      "id": "sound",
      "label": "音效",
      "fields": [
        { "key": "fireSoundOne", "label": "开火音效", "type": "enum", "default": "", "source": "config:sounds" },
        { "key": "fireSoundTwo", "label": "开火音效 2", "type": "enum", "default": "", "source": "config:sounds" },
        { "key": "stopPreviousFireSound", "label": "停止上次开火音效", "type": "boolean", "default": false },
        {
          "key": "fadePreviousFireSound",
          "label": "上次音效淡出时间",
          "type": "float",
          "default": 0,
          "visibleWhen": { "specClass": ["projectile"] }
        },
        {
          "key": "noImpactSounds",
          "label": "关闭命中音效",
          "type": "boolean",
          "default": false,
          "visibleWhen": { "specClass": ["projectile"] }
        },
        {
          "key": "noShieldImpactSounds",
          "label": "关闭护盾命中音效",
          "type": "boolean",
          "default": false,
          "visibleWhen": { "specClass": ["projectile"] }
        },
        {
          "key": "noNonShieldImpactSounds",
          "label": "关闭非护盾命中音效",
          "type": "boolean",
          "default": false,
          "visibleWhen": { "specClass": ["projectile"] }
        },
        {
          "key": "playFullFireSoundOne",
          "label": "完整播放首音效",
          "type": "boolean",
          "default": false,
          "visibleWhen": { "specClass": ["beam"] }
        }
      ]
    },
    {
      "id": "scripts",
      "label": "脚本",
      "fields": [
        { "key": "everyFrameEffect", "label": "逐帧效果脚本", "type": "string", "default": "" },
        { "key": "beamEffect", "label": "光束效果脚本", "type": "string", "default": "", "visibleWhen": { "specClass": ["beam"] } }
      ]
    },
    {
      "id": "advanced",
      "label": "高级属性",
      "fields": [
        { "key": "mountTypeOverride", "label": "挂载类型", "type": "enum", "default": "", "ref": "spec-weapon#/definitions/enum1" },
        { "key": "displayArcRadius", "label": "显示射界半径", "type": "float", "default": 250 }
      ]
    }
  ],
  "definitions": {
    "muzzleFlashSpec": {
      "key": "muzzleFlashSpec",
      "label": "闪光配置",
      "type": "object",
      "nested": [
        { "key": "length", "label": "长度", "type": "float", "requiredWhen": { "particleCount": { "min": 1 } } },
        { "key": "spread", "label": "散布", "type": "float", "requiredWhen": { "particleCount": { "min": 1 } } },
        {
          "key": "particleSizeMin",
          "label": "最小粒子尺寸",
          "type": "float",
          "requiredWhen": { "particleCount": { "min": 1 } }
        },
        {
          "key": "particleSizeRange",
          "label": "粒子尺寸变化",
          "type": "float",
          "requiredWhen": { "particleCount": { "min": 1 } }
        },
        {
          "key": "particleDuration",
          "label": "粒子持续时间",
          "type": "float",
          "requiredWhen": { "particleCount": { "min": 1 } }
        },
        { "key": "particleCount", "label": "粒子数量", "type": "float", "default": 0, "required": true },
        { "key": "particleColor", "label": "粒子颜色", "type": "color-rgba", "default": [255, 255, 255, 255] }
      ]
    },
    "smokeSpec": {
      "key": "smokeSpec",
      "label": "烟雾配置",
      "type": "object",
      "nested": [
        { "key": "particleSizeMin", "label": "最小粒子尺寸", "type": "float", "default": 0, "required": true },
        { "key": "particleSizeRange", "label": "粒子尺寸变化", "type": "float", "default": 0, "required": true },
        { "key": "cloudParticleCount", "label": "云团粒子数量", "type": "float", "default": 0, "required": true },
        { "key": "cloudDuration", "label": "云团持续时间", "type": "float", "default": 0, "required": true },
        { "key": "cloudRadius", "label": "云团半径", "type": "float", "default": 0, "required": true },
        { "key": "blowbackParticleCount", "label": "回喷粒子数量", "type": "float", "default": 0, "required": true },
        { "key": "blowbackDuration", "label": "回喷持续时间", "type": "float", "default": 0, "required": true },
        { "key": "blowbackLength", "label": "回喷长度", "type": "float", "default": 0, "required": true },
        { "key": "blowbackSpread", "label": "回喷散布", "type": "float", "default": 0, "required": true },
        { "key": "particleColor", "label": "粒子颜色", "type": "color-rgba", "default": [255, 255, 255, 255] }
      ]
    },
    "save": {
      "key": "save",
      "label": "保存",
      "type": "object",
      "nested": [
        {
          "key": "specClass",
          "label": "规格类型",
          "type": "enum",
          "required": true,
          "options": ["projectile", "beam"],
          "issueCode": "spec.weapon_class_unsupported",
          "issueMessage": "规格类型只允许 projectile 或 beam"
        },
        {
          "key": "turretOffsets",
          "label": "炮塔配置",
          "type": "array",
          "required": true,
          "minEntries": 2,
          "issueCode": "spec.weapon_turret_barrel_required",
          "issueMessage": "至少需要一个发射点"
        },
        {
          "key": "hardpointOffsets",
          "label": "固定配置",
          "type": "array",
          "required": true,
          "minEntries": 2,
          "issueCode": "spec.weapon_hardpoint_barrel_required",
          "issueMessage": "至少需要一个发射点"
        }
      ]
    },
    "enum1": {
      "key": "enum1",
      "label": "选项",
      "type": "enum",
      "options": ["BALLISTIC", "ENERGY", "MISSILE", "HYBRID", "UNIVERSAL", "SYNERGY", "COMPOSITE", "DECORATIVE", "SYSTEM", "BUILT_IN"]
    },
    "enum2": {
      "key": "enum2",
      "label": "选项",
      "type": "enum",
      "options": [
        "NONE",
        "RAY",
        "RAY_FIGHTER",
        "FIGHTER",
        "SHIP",
        "PROJECTILE_NO_FF",
        "PROJECTILE_FF",
        "MISSILE_NO_FF",
        "MISSILE_FF",
        "HITS_SHIPS_AND_ASTEROIDS",
        "HITS_SHIPS_ONLY_FF",
        "HITS_SHIPS_ONLY_NO_FF",
        "PROJECTILE_FIGHTER",
        "ASTEROID",
        "PLANET",
        "GAS_CLOUD",
        "STAR"
      ]
    }
  }
}
