{
  "$schema": "circinus-ad-astra/field-schema/v1",
  "id": "variant",
  "fileType": "variant",
  "displayName": "装配",
  "description": "Starsector .variant 装配文件",
  "sections": [
    {
      "id": "basic",
      "label": "基础",
      "fields": [
        {
          "key": "variantId",
          "type": "string",
          "label": "装配 ID",
          "required": true
        },
        {
          "key": "hullId",
          "type": "enum",
          "label": "船体 ID",
          "required": true,
          "source": "csv:ships.id"
        },
        { "key": "displayName", "type": "string", "label": "显示名称" },
        { "key": "goalVariant", "type": "boolean", "label": "默认可选装配" }
      ]
    },
    {
      "id": "flux",
      "label": "幅能",
      "fields": [
        {
          "key": "fluxVents",
          "type": "integer",
          "label": "耗散通道",
          "min": 0
        },
        {
          "key": "fluxCapacitors",
          "type": "integer",
          "label": "幅能寄存器",
          "min": 0
        }
      ]
    },
    {
      "id": "mods",
      "label": "插件",
      "fields": [
        {
          "key": "hullMods",
          "type": "string-array",
          "label": "船体插件",
          "source": "csv:hullmods.id"
        },
        {
          "key": "permaMods",
          "type": "string-array",
          "label": "永久插件",
          "source": "csv:hullmods.id"
        },
        {
          "key": "sMods",
          "type": "string-array",
          "label": "S 插件",
          "source": "csv:hullmods.id"
        }
      ]
    },
    {
      "id": "weapons",
      "label": "武器组",
      "fields": [
        {
          "key": "weaponGroups",
          "type": "array",
          "label": "武器组",
          "item": {
            "key": "item",
            "label": "武器组",
            "type": "object",
            "default": { "mode": "LINKED", "weapons": {}, "autofire": false },
            "nested": [
              {
                "key": "mode",
                "type": "enum",
                "label": "模式",
                "options": ["LINKED", "ALTERNATING"],
                "required": true
              },
              {
                "key": "weapons",
                "type": "object",
                "label": "武器",
                "valueSchema": {
                  "key": "weaponId",
                  "type": "enum",
                  "label": "武器 ID",
                  "source": "csv:weapons.id"
                },
                "required": true,
                "allowExtraFields": true
              },
              { "key": "autofire", "type": "boolean", "label": "自动开火" }
            ]
          }
        }
      ]
    },
    {
      "id": "wings",
      "label": "战机联队",
      "fields": [
        {
          "key": "wings",
          "type": "array",
          "label": "战机联队",
          "item": {
            "key": "wingId",
            "type": "enum",
            "label": "战机联队 ID",
            "source": "csv:wings.id",
            "default": ""
          }
        }
      ]
    },
    {
      "id": "modules",
      "label": "模块",
      "fields": [
        {
          "key": "modules",
          "type": "object",
          "format": "array-of-entries",
          "label": "模块",
          "valueSchema": {
            "key": "variantId",
            "type": "string",
            "label": "装配 ID"
          },
          "allowExtraFields": true
        }
      ]
    }
  ]
}
