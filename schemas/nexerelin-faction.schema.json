        "allowExtraFields": true
      },
      {
        "key": "maxRelationships",
        "type": "object",
        "label": "最高外交关系",
        "keySchema": {
          "key": "faction",
          "type": "string",
          "label": "势力 ID",
          "default": "faction"
        },
        "valueSchema": {
          "key": "relationship",
          "type": "float",
          "label": "关系值"
        },
        "allowExtraFields": true
      }
