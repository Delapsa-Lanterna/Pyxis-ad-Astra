{
  "name": "circinus-architecture-audit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "node ../node_modules/prettier/bin/prettier.cjs --config ../.prettierrc --ignore-path ../.prettierignore --check src test package.json tsconfig.json README.md",
    "lint": "npm --prefix .. run lint",
    "lint:full": "npm --prefix .. run lint:full",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "node src/cli.mjs check"
  },
  "dependencies": {
    "@dagrejs/dagre": "1.1.8",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/compiler-dom": "3.5.44",
    "@vue/language-core": "3.3.13",
    "@volar/language-core": "2.4.28",
    "@volar/typescript": "2.4.28",
    "dependency-cruiser": "18.6.0",
    "graphlib": "2.1.8",
    "vis-network": "9.1.13",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@types/emscripten": "^1.41.5",
    "@types/graphlib": "2.1.12",
    "@volar/language-service": "2.4.28"
  }
}
